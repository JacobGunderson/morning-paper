{
  "name": "morning-paper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --exclude 'tests/e2e/**' && (test -x .venv/bin/pytest && .venv/bin/pytest -q || python3 -m pytest -q)",
    "test:ts": "vitest run --exclude 'tests/e2e/**'",
    "test:py": "test -x .venv/bin/pytest && .venv/bin/pytest -q || python3 -m pytest -q",
    "test:e2e": "playwright test",
    "refresh": "python3 scripts/refresh.py",
    "refresh:comics": ".venv/bin/python -u scripts/refresh_comics.py && npm run build",
    "comics:browser": "python3 scripts/open_gocomics_browser.py",
    "refresh:local": "MORNING_PAPER_CDP_URL=http://127.0.0.1:9222 .venv/bin/python -u scripts/refresh.py && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
